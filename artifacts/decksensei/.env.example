# ─── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/topdeckcoach

# ─── IA ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública do app (sem barra final). Usada nos magic links.
APP_URL=https://topdeckcoach.com.br

# ─── Admin ───────────────────────────────────────────────────────────────────
# E-mail único que tem acesso ao painel /admin.
ADMIN_EMAIL=seu@email.com
# Senha do painel /admin (usada junto com ADMIN_EMAIL).
# Deve ser uma string aleatória com no mínimo 32 caracteres.
# Gere com: openssl rand -hex 24
ADMIN_TOKEN=troque-por-string-aleatoria-de-32-ou-mais-chars-aqui

# ─── Limites (opcional) ──────────────────────────────────────────────────────
# Custo máximo diário de produção em USD antes de bloquear análises (padrão: 10)
DAILY_COST_CAP_USD=10
# Custo máximo diário de testes admin em USD (padrão: 2 — isolado do cap de produção)
TEST_DAILY_COST_CAP_USD=2
