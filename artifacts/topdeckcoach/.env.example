# ─── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/topdeckcoach

# ─── IA ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública do app (sem barra final). Usada nos magic links.
APP_URL=https://topdeckcoach.com.br

# ─── Admin ───────────────────────────────────────────────────────────────────
# E-mail único que tem acesso ao painel /admin.
ADMIN_EMAIL=seu@email.com
# Senha do painel /admin (usada junto com ADMIN_EMAIL). Gere com: openssl rand -hex 16
ADMIN_TOKEN=troque-por-um-valor-aleatorio-seguro-aqui

# ─── Limites (opcional) ──────────────────────────────────────────────────────
# Custo máximo diário em USD antes de bloquear análises (padrão: 10)
DAILY_COST_CAP_USD=10
