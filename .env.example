# ─── Banco de dados (auto-injetado pelo Postgres do Replit) ───────────────────
DATABASE_URL=postgresql://user:password@host:5432/database

# ─── Anthropic (motor de análise IA) ─────────────────────────────────────────
# Chave da API Anthropic. Confirme o model string atual em https://docs.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Resend (envio de magic link por email) ───────────────────────────────────
RESEND_API_KEY=re_...

# ─── Admin ────────────────────────────────────────────────────────────────────
# String aleatória de 32+ caracteres para autenticar o painel admin.
# Gere com: openssl rand -base64 32
ADMIN_TOKEN=troque-por-string-aleatoria-de-32-ou-mais-caracteres

# ─── Limites de custo ────────────────────────────────────────────────────────
# Teto diário de gasto na Anthropic API (em USD). Default: 10
DAILY_COST_CAP_USD=10

# ─── URL pública do app ──────────────────────────────────────────────────────
# Exemplo: https://topdeckcoach.com ou a URL do Replit em dev
APP_URL=https://topdeckcoach.com
